# ================================
# ArthCafe — Environment Variables
# ================================

# App
APP_NAME=ArthCafe API
DEBUG=true

# Database (Neon PostgreSQL)
DATABASE_URL=postgresql+asyncpg://user:password@ep-xxx.us-east-2.aws.neon.tech/arthcafe?sslmode=require

# JWT
SECRET_KEY=change-me-to-a-random-64-char-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Razorpay (test keys)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxx

# Firebase (path to service account JSON)
FIREBASE_CREDENTIALS_PATH=./firebase-service-account.json

# WhatsApp (mock for MVP)
WHATSAPP_API_URL=
WHATSAPP_API_KEY=
CAFE_OWNER_PHONE=+91XXXXXXXXXX

# OTP
OTP_MOCK=true
OTP_MOCK_CODE=123456
